# ============================================================
#  Echo - example configuration
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real .env file.
# ============================================================

# --- Required credentials -----------------------------------
DISCORD_BOT_TOKEN=your-discord-bot-token-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# --- OpenRouter tuning --------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Echo
OPENROUTER_APP_URL=
OPENROUTER_TEMPERATURE=0.92
OPENROUTER_MAX_TOKENS=160
OPENROUTER_TIMEOUT=30
OPENROUTER_MAX_RETRIES=2

# --- PostgreSQL ---------------------------------------------
# Preferred on hosts like Render: set the full connection string.
# If DATABASE_URL is set it is used as-is; otherwise the PG* fields below.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-postgres-password-here
PGDATABASE=discord-chatbot-ai

# --- Channels (comma-separated IDs) -------------------------
# When the bot is @mentioned it replies automatically in EVERY non-blocked
# channel. To restrict mentions to specific channels, list them here (acts as
# an allowlist). Leave empty to allow all channels.
AI_CHANNEL_IDS=
# Channels where the bot may also join conversations WITHOUT being mentioned.
# Normal-message auto-replies are opt-in: leave empty to fully disable them.
AUTONOMOUS_CHANNEL_IDS=
# Channels the bot must never touch.
BLOCKED_CHANNEL_IDS=

# --- Autonomy -----------------------------------------------
# Master switch for normal-message (non-mention) replies. OFF by default.
MENTION_REPLIES_ENABLED=true
AUTONOMOUS_ENABLED=false
AUTONOMOUS_PROBABILITY=0.08
AUTONOMOUS_MIN_MESSAGES=3

# --- Personality --------------------------------------------
# When true, ECHO curses back (gaali) when someone abuses/roasts it.
ALLOW_PROFANITY=true

# --- Cooldowns / cost control -------------------------------
USER_COOLDOWN_SECONDS=20
GLOBAL_COOLDOWN_SECONDS=4
MAX_RESPONSES_PER_MINUTE=8
DAILY_REQUEST_BUDGET=600

# --- Context / memory ---------------------------------------
CONTEXT_MESSAGES=12
CONTEXT_CHAR_BUDGET=6000
MAX_INPUT_LENGTH=1200
MAX_REPLY_LENGTH=360
PER_CHANNEL_HISTORY_CAP=60

# --- Permissions --------------------------------------------
# Users in these lists (and members with these roles) can change settings.
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
LOG_CHANNEL_ID=0

# --- Development --------------------------------------------
# If set, slash commands sync instantly to this guild (great for testing).
DEV_GUILD_ID=0
